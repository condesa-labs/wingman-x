{
  "name": "chrome-twitter-helper",
  "private": true,
  "version": "0.1.1",
  "description": "Chrome extension + local companion daemon for agent-generated, voice-matched Twitter replies",
  "workspaces": [
    "packages/daemon",
    "packages/extension",
    "packages/agent-kit",
    "packages/sample-kb"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm -ws --if-present run test",
    "typecheck": "npm -ws --if-present run typecheck",
    "build": "npm run bump:patch && npm -ws --if-present run build",
    "build:no-bump": "npm -ws --if-present run build",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "bump:sync": "node scripts/bump-version.mjs sync"
  }
}
