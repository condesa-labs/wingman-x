{
  "manifest_version": 3,
  "name": "Twitter Helper",
  "version": "0.1.0",
  "description": "Agent-agnostic semi-auto reply assistant for Twitter / X.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*/status/*",
        "https://x.com/*/status/*",
        "http://localhost/*/status/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "http://localhost/*"
      ],
      "js": ["viral-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["viral-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitter Helper"
  },
  "web_accessible_resources": [
    {
      "resources": ["notification-icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
